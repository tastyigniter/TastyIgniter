parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$model of method Igniter\\Flame\\Database\\Relations\\BelongsTo\:\:associate\(\) expects Illuminate\\Database\\Eloquent\\Model\|int\|string\|null, Illuminate\\Contracts\\Auth\\Authenticatable\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Classes/BookingManager.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$reservation_datetime\.$#'
			identifier: property.notFound
			count: 1
			path: src/Models/Reservation.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$reservation_end_datetime\.$#'
			identifier: property.notFound
			count: 1
			path: src/Models/Reservation.php

		-
			message: '#^Call to an undefined method Igniter\\Flame\\Database\\Builder\<Igniter\\Reservation\\Models\\DiningTable\>\|Illuminate\\Database\\Eloquent\\Builder\<Igniter\\Reservation\\Models\\DiningTable\>\:\:reservable\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Models/Reservation.php

		-
			message: '#^Call to an undefined method Illuminate\\Support\\Carbon\:\:diffInRealMinutes\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Models/Reservation.php

		-
			message: '#^Relation ''tables'' is not found in Igniter\\Reservation\\Models\\Reservation model\.$#'
			identifier: larastan.relationExistence
			count: 1
			path: src/Models/Reservation.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:fireEvent\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Models/Scopes/DiningTableScope.php

		-
			message: '#^Method Illuminate\\Database\\Eloquent\\Builder\<Illuminate\\Database\\Eloquent\\Model\>\:\:whereBetweenReservationDateTime\(\) invoked with 2 parameters, 0\-1 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Models/Scopes/ReservationScope.php
